# Yorutsuke v2 Environment Variables
# Copy to .env.local and fill in values from CDK outputs
# Or run: npm run env:sync (requires AWS CLI)

# ============================================================
# Lambda Function URLs (Required)
# ============================================================
# These are AWS Lambda function URLs for the backend APIs
# Format: https://{random-id}.lambda-url.{region}.on.aws/
# Region: us-east-1 (primary)
# Get values from: cdk deploy output

VITE_LAMBDA_PRESIGN_URL=
VITE_LAMBDA_SYNC_URL=
VITE_LAMBDA_CONFIG_URL=
VITE_LAMBDA_QUOTA_URL=
VITE_LAMBDA_ADMIN_DELETE_URL=

# ============================================================
# Authentication API
# ============================================================
# Base URL for custom auth service (not Cognito)
VITE_AUTH_API_URL=

# ============================================================
# Debug Panel (Developer Only)
# ============================================================
# Show debug panel in development
# Modes: 'off' (real API) | 'online' (mock) | 'offline' (network fail)
# Unlock by typing 'debug' anywhere in the app
# See docs/operations/DEBUG_PANEL.md for details

VITE_DEBUG_PANEL=false

# ============================================================
# Diagnostic Export Configuration
# ============================================================
# Customize diagnostic collection limits and behavior
# Useful for testing with different data volumes
# Default values are optimized for most use cases

# Maximum debug logs to collect (default: 50)
# Reduce for smaller reports, increase for more detailed logging
VITE_DIAGNOSTIC_MAX_LOGS=50

# Maximum transactions to collect (default: 30)
# Reduce for smaller reports, increase for more transaction details
VITE_DIAGNOSTIC_MAX_TRANSACTIONS=30

# Log level filter: 'true' = ERROR/WARN/INFO only, 'false' = all levels including DEBUG (default: true)
# Set to 'false' to include all log levels (increases report size)
VITE_DIAGNOSTIC_LOG_FILTER=true

# Retry configuration (for Lambda communication)
# Maximum retry attempts if Lambda call fails (default: 3)
VITE_DIAGNOSTIC_MAX_RETRIES=3

# Delay between retry attempts in milliseconds (default: 1000)
VITE_DIAGNOSTIC_RETRY_DELAY_MS=1000

# Request timeout in milliseconds (default: 30000 = 30 seconds)
VITE_DIAGNOSTIC_REQUEST_TIMEOUT_MS=30000
