{
  "name": "yorutsuke-v2-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff --profile dev",
    "deploy": "cdk deploy --profile dev && bash ../scripts/sync-env.sh",
    "destroy": "cdk destroy --profile dev",
    "txn:latest": "AWS_PROFILE=dev node ../scripts/query-latest-transactions.mjs dev 10",
    "txn:latest:prod": "AWS_PROFILE=prod node ../scripts/query-latest-transactions.mjs prod 10",
    "txn:query": "AWS_PROFILE=dev node ../scripts/query-latest-transactions.mjs",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.19.0",
    "glob": "^10.0.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.971.0",
    "@aws-sdk/util-dynamodb": "^3.971.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.0"
  }
}
